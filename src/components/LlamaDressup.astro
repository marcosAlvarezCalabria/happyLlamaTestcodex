---
const accessories = [
  { id: 'hat', label: 'Beanie', icon: '🧶', src: '/assets/accessories/hat.svg' },
  { id: 'glasses', label: 'Shades', icon: '😎', src: '/assets/accessories/glasses.svg' },
  { id: 'scarf', label: 'Scarf', icon: '🧣', src: '/assets/accessories/scarf.svg' },
  { id: 'headphones', label: 'Tunes', icon: '🎧', src: '/assets/accessories/headphones.svg' },
  { id: 'pendant', label: 'Pendant', icon: '💖', src: '/assets/accessories/pendant.svg' },
  { id: 'flowers', label: 'Flowers', icon: '🌸', src: '/assets/accessories/flowers.svg' },
];
---

<section class="dressup" aria-labelledby="dressup-title">
  <div class="dressup-heading">
    <div>
      <p class="kicker">Make it yours</p>
      <h2 id="dressup-title">Dress your llama</h2>
    </div>
    <p>Tap to add or remove</p>
  </div>

  <div class="dressup-stage" id="dressup-stage" aria-live="polite">
    <img class="dressup-base" src="/assets/llama/base.svg" alt="Your llama" width="500" height="600" />
    {
      accessories.map((item) => (
        <img
          class="accessory-layer"
          data-accessory={item.id}
          src={item.src}
          alt=""
          width="500"
          height="600"
          hidden
        />
      ))
    }
    <div class="boop" aria-hidden="true">pop!</div>
  </div>

  <div class="accessory-rail" role="group" aria-label="Llama accessories">
    {
      accessories.map((item) => (
        <button class="accessory-button" type="button" data-toggle={item.id} aria-pressed="false">
          <span class="accessory-icon" aria-hidden="true">{item.icon}</span>
          <span>{item.label}</span>
        </button>
      ))
    }
  </div>
  <p class="dressup-status sr-only" id="dressup-status" role="status"></p>
</section>

<script>
  const dressupStage = document.querySelector<HTMLElement>('#dressup-stage');
  const accessoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-toggle]'));
  const accessoryLayers = Array.from(document.querySelectorAll<HTMLImageElement>('[data-accessory]'));
  const dressupStatus = document.querySelector<HTMLElement>('#dressup-status');
  const query = new URLSearchParams(window.location.search);
  const cardId = (query.get('id') || 'demo').replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 24) || 'demo';
  const storageKey = `happy-llama-outfit:${cardId}`;
  let active = new Set<string>();

  try {
    const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
    if (Array.isArray(saved)) active = new Set(saved.filter((item) => typeof item === 'string'));
  } catch {
    active = new Set();
  }

  const renderOutfit = (changed?: string) => {
    accessoryLayers.forEach((layer) => {
      layer.hidden = !active.has(layer.dataset.accessory || '');
    });
    accessoryButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(active.has(button.dataset.toggle || '')));
    });
    try {
      localStorage.setItem(storageKey, JSON.stringify([...active]));
    } catch {}

    if (changed && dressupStage) {
      dressupStage.classList.remove('is-booping');
      requestAnimationFrame(() => dressupStage.classList.add('is-booping'));
      window.setTimeout(() => dressupStage.classList.remove('is-booping'), 500);
      const button = accessoryButtons.find((item) => item.dataset.toggle === changed);
      const label = button?.textContent?.trim() || changed;
      if (dressupStatus) dressupStatus.textContent = `${label} ${active.has(changed) ? 'added' : 'removed'}.`;
    }
  };

  accessoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.toggle;
      if (!id) return;
      active.has(id) ? active.delete(id) : active.add(id);
      renderOutfit(id);
    });
  });

  renderOutfit();
</script>
