---
import BrandMark from './BrandMark.astro';

const scenes = [
  { name: 'Galway Harbour', src: '/assets/scenes/galway.webp' },
  { name: 'Cusco', src: '/assets/scenes/cusco.webp' },
  { name: 'Machu Picchu', src: '/assets/scenes/machupicchu.webp' },
  { name: 'The Andes', src: '/assets/scenes/andes.webp' },
  { name: 'Cliffs of Moher', src: '/assets/scenes/moher.webp' },
  { name: "Giant's Causeway", src: '/assets/scenes/causeway.webp' },
  { name: 'Dublin', src: '/assets/scenes/dublin.webp' },
  { name: 'Rainbow Mountain', src: '/assets/scenes/rainbow.webp' },
];
---

<main class="creator-shell" data-mode="creator">
  <header class="creator-header page-width">
    <BrandMark />
    <div class="creator-header-actions">
      <div class="language-switch" role="group" aria-label="Idioma / Language">
        <button type="button" data-language="es" aria-pressed="true">ES</button>
        <button type="button" data-language="en" aria-pressed="false">EN</button>
      </div>
      <div class="header-note">
        <span class="nfc-dot" aria-hidden="true"></span>
        <span data-i18n="nfcLabel">Recordatorio NFC</span>
      </div>
    </div>
  </header>

  <div class="creator-grid page-width">
    <section class="creator-copy" aria-labelledby="creator-title">
      <p class="kicker" data-i18n="kicker">De Galway, con cariño</p>
      <h1 id="creator-title" data-i18n="title">Crea un recordatorio que viaja con su llama.</h1>
      <p class="intro" data-i18n="intro">
        Escribe unas palabras, elige el lugar y copia el enlace que grabarás en el colgante.
      </p>

      <form class="keepsake-form" id="keepsake-form" novalidate>
        <fieldset class="type-fieldset">
          <legend data-i18n="typeLegend">¿Qué quieres grabar en la pegatina?</legend>
          <div class="type-selector">
            <label class="type-choice">
              <input type="radio" name="sticker-type" value="reminder" checked />
              <span class="type-choice-card">
                <span class="type-icon" aria-hidden="true">♥</span>
                <strong data-i18n="reminderType">Recuerdo</strong>
                <small data-i18n="reminderTypeHelp">Un mensaje personal con el lugar que elijas.</small>
              </span>
            </label>
            <label class="type-choice">
              <input type="radio" name="sticker-type" value="story" />
              <span class="type-choice-card">
                <span class="type-icon type-icon-story" aria-hidden="true">✦</span>
                <strong data-i18n="storyType">Cómo se hizo</strong>
                <small data-i18n="storyTypeHelp">Una pequeña historia de los textiles andinos.</small>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="story-creator-preview" data-story-field hidden>
          <div class="story-preview-image" aria-hidden="true"></div>
          <div class="story-preview-copy">
            <p data-i18n="storyPreviewKicker">Historia de la llama</p>
            <h2 data-i18n="storyPreviewTitle">De los Andes a Galway</h2>
            <span data-i18n="storyPreviewBody">Una historia visual sobre fibras, color y tejido.</span>
          </div>
        </div>

        <div class="reminder-fields" data-reminder-field>
        <div class="mobile-live-preview" aria-label="Vista previa que se actualiza mientras editas" data-i18n-aria="livePreviewAria">
          <div class="mobile-preview-label"><i aria-hidden="true"></i><span data-i18n="previewWhileTyping">Vista previa mientras escribes</span></div>
          <div class="mobile-preview-card scene-0" data-live-preview>
            <div class="mobile-preview-scene" aria-hidden="true"></div>
            <img
              class="mobile-preview-llama"
              src="/assets/llama/cream-cutout.webp"
              alt=""
              width="1254"
              height="1254"
              aria-hidden="true"
            />
            <div class="mobile-preview-message">
              <p>A little reminder from Galway</p>
              <blockquote data-preview-message>I was in Galway and thought of you 🦙</blockquote>
              <span data-preview-from>With love, Happy Llama</span>
            </div>
          </div>
        </div>

        <label for="message">
          <span data-i18n="messageLabel">Mensaje</span>
          <span class="character-count"><span id="message-count">0</span>/120</span>
        </label>
        <textarea
          id="message"
          name="message"
          maxlength="120"
          rows="4"
          placeholder="I was in Galway and thought of you 🦙"
          required></textarea>
        <p class="field-error" id="message-error" data-i18n="messageError" hidden>Escribe primero el mensaje del recordatorio.</p>

        <label for="from"><span data-i18n="fromLabel">De parte de</span> <span class="optional" data-i18n="optional">opcional</span></label>
        <input id="from" name="from" type="text" maxlength="60" placeholder="With love, María" />

        <fieldset class="scene-fieldset">
          <legend data-i18n="sceneLegend">Elige una escena</legend>
          <div class="scene-picker">
            {
              scenes.map((scene, index) => (
                <label class="scene-choice" title={scene.name}>
                  <input type="radio" name="scene" value={index} checked={index === 0} />
                  <span class="scene-swatch" style={`--scene-image: url('${scene.src}')`}>
                    <span>{scene.name}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        </div>

        <button class="primary-button" id="copy-link" type="submit" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8.5 12.5 15 6a3 3 0 0 1 4.2 4.2l-8.5 8.5a5 5 0 0 1-7.1-7.1l8-8" />
          </svg>
          <span data-copy-label>Copiar enlace para la pegatina</span>
        </button>
        <p class="microcopy" data-mode-help>Graba este enlace en el colgante con NFC Tools.</p>

        <div class="link-result" id="link-result" hidden>
          <p id="copy-status" role="status"></p>
          <a id="generated-link" href="#" target="_blank" rel="noreferrer"></a>
          <button class="text-button" id="open-preview" type="button" data-open-label>Abrir la vista del regalo →</button>
        </div>
      </form>
    </section>

    <aside class="preview-zone" aria-label="Vista previa del recordatorio" data-i18n-aria="desktopPreviewAria">
      <div data-reminder-preview>
      <div class="preview-label"><i aria-hidden="true"></i><span data-i18n="livePreview">Vista previa en vivo</span></div>
      <div class="keepsake-card scene-0" data-live-preview>
        <div class="preview-scene" aria-hidden="true"></div>
        <div class="preview-llama" aria-hidden="true">
          <img src="/assets/llama/cream-cutout.webp" alt="" width="1254" height="1254" />
        </div>
        <div class="preview-message">
          <p>A little reminder from Galway</p>
          <blockquote data-preview-message>I was in Galway and thought of you 🦙</blockquote>
          <span data-preview-from>With love, Happy Llama</span>
        </div>
        <div class="card-stitch" aria-hidden="true"></div>
      </div>
      <p class="preview-tip" data-i18n="privacyTip">El mensaje viaja dentro del enlace. No guardamos ningún dato.</p>
      </div>
      <div class="story-side-preview" data-story-preview hidden>
        <div class="preview-label"><i aria-hidden="true"></i><span data-i18n="storyPreviewLabel">Vista previa de la historia</span></div>
        <div class="story-side-frame">
          <img src="/assets/brand/happy-llama-logo.png" alt="Happy Llama" width="141" height="83" />
          <div>
            <p data-i18n="storySideKicker">De Perú a Irlanda</p>
            <h2 data-i18n="storySideTitle">Where your llama comes from</h2>
          </div>
          <span data-i18n="storySideCaption">Tradición, color y manos que tejen.</span>
        </div>
        <p class="preview-tip" data-i18n="storyPrivacyTip">El mismo enlace sirve para todas las pegatinas de historia.</p>
      </div>
    </aside>
  </div>

  <footer class="creator-footer page-width">
    <span>🦙 Happy Llama</span>
    <span data-i18n="footerOrigin">Hecho en Perú · Terminado en Galway</span>
  </footer>
</main>

<script>
  const form = document.querySelector<HTMLFormElement>('#keepsake-form');
  const message = document.querySelector<HTMLTextAreaElement>('#message');
  const from = document.querySelector<HTMLInputElement>('#from');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-link');
  const previewMessages = Array.from(document.querySelectorAll<HTMLElement>('[data-preview-message]'));
  const previewSignatures = Array.from(document.querySelectorAll<HTMLElement>('[data-preview-from]'));
  const count = document.querySelector<HTMLElement>('#message-count');
  const livePreviews = Array.from(document.querySelectorAll<HTMLElement>('[data-live-preview]'));
  const linkResult = document.querySelector<HTMLElement>('#link-result');
  const generatedLink = document.querySelector<HTMLAnchorElement>('#generated-link');
  const copyStatus = document.querySelector<HTMLElement>('#copy-status');
  const openPreview = document.querySelector<HTMLButtonElement>('#open-preview');
  const error = document.querySelector<HTMLElement>('#message-error');
  const languageButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-language]'));
  const typeInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[name="sticker-type"]'));
  const reminderFields = Array.from(document.querySelectorAll<HTMLElement>('[data-reminder-field]'));
  const storyFields = Array.from(document.querySelectorAll<HTMLElement>('[data-story-field]'));
  const reminderPreviews = Array.from(document.querySelectorAll<HTMLElement>('[data-reminder-preview]'));
  const storyPreviews = Array.from(document.querySelectorAll<HTMLElement>('[data-story-preview]'));
  const copyLabel = document.querySelector<HTMLElement>('[data-copy-label]');
  const modeHelp = document.querySelector<HTMLElement>('[data-mode-help]');
  const openLabel = document.querySelector<HTMLElement>('[data-open-label]');

  type CreatorLanguage = 'es' | 'en';

  const translations: Record<CreatorLanguage, Record<string, string>> = {
    es: {
      nfcLabel: 'Recordatorio NFC',
      kicker: 'De Galway, con cariño',
      title: 'Crea un recordatorio que viaja con su llama.',
      intro: 'Escribe unas palabras, elige el lugar y copia el enlace que grabarás en el colgante.',
      typeLegend: '¿Qué quieres grabar en la pegatina?',
      reminderType: 'Recuerdo',
      reminderTypeHelp: 'Un mensaje personal con el lugar que elijas.',
      storyType: 'Cómo se hizo',
      storyTypeHelp: 'Una pequeña historia de los textiles andinos.',
      storyPreviewKicker: 'Historia de la llama',
      storyPreviewTitle: 'De los Andes a Galway',
      storyPreviewBody: 'Una historia visual sobre fibras, color y tejido.',
      storyPreviewLabel: 'Vista previa de la historia',
      storySideKicker: 'De Perú a Irlanda',
      storySideTitle: 'Where your llama comes from',
      storySideCaption: 'Tradición, color y manos que tejen.',
      storyPrivacyTip: 'El mismo enlace sirve para todas las pegatinas de historia.',
      livePreviewAria: 'Vista previa que se actualiza mientras editas',
      previewWhileTyping: 'Vista previa mientras escribes',
      messageLabel: 'Mensaje',
      messageError: 'Escribe primero el mensaje del recordatorio.',
      fromLabel: 'De parte de',
      optional: 'opcional',
      sceneLegend: 'Elige una escena',
      copyButton: 'Copiar enlace para la pegatina',
      microcopy: 'Graba este enlace en el colgante con NFC Tools.',
      openPreview: 'Abrir la vista del regalo →',
      desktopPreviewAria: 'Vista previa del recordatorio',
      livePreview: 'Vista previa en vivo',
      privacyTip: 'El mensaje viaja dentro del enlace. No guardamos ningún dato.',
      footerOrigin: 'Hecho en Perú · Terminado en Galway',
      copied: '✓ Enlace copiado. Ya puedes grabarlo en el NFC.',
      ready: 'Enlace listo. Mantén pulsado para copiarlo.',
      copyReminderButton: 'Copiar enlace para la pegatina',
      copyStoryButton: 'Copiar enlace de Cómo se hizo',
      reminderMicrocopy: 'Graba este enlace en el colgante con NFC Tools.',
      storyMicrocopy: 'Este mismo enlace sirve para todas las pegatinas de historia.',
      openReminder: 'Abrir la vista del regalo →',
      openStory: 'Abrir Cómo se hizo →',
      storyCopied: '✓ Enlace de la historia copiado. Puedes usarlo en todas las pegatinas.',
    },
    en: {
      nfcLabel: 'NFC reminder',
      kicker: 'From Galway, with love',
      title: 'Create a reminder that travels with their llama.',
      intro: 'Write a few words, choose a place and copy the link you will save to the pendant.',
      typeLegend: 'What would you like to save to the tag?',
      reminderType: 'Reminder',
      reminderTypeHelp: 'A personal message with a place you choose.',
      storyType: 'How it was made',
      storyTypeHelp: 'A short story about Andean textile traditions.',
      storyPreviewKicker: 'The llama story',
      storyPreviewTitle: 'From the Andes to Galway',
      storyPreviewBody: 'A visual story about fibres, colour and weaving.',
      storyPreviewLabel: 'Story preview',
      storySideKicker: 'From Peru to Ireland',
      storySideTitle: 'Where your llama comes from',
      storySideCaption: 'Tradition, colour and hands that weave.',
      storyPrivacyTip: 'The same link works for every story tag.',
      livePreviewAria: 'Preview that updates while you edit',
      previewWhileTyping: 'Preview while you type',
      messageLabel: 'Message',
      messageError: 'Write the reminder message first.',
      fromLabel: 'From',
      optional: 'optional',
      sceneLegend: 'Choose a scene',
      copyButton: 'Copy link for the NFC tag',
      microcopy: 'Save this link to the pendant with NFC Tools.',
      openPreview: 'Open the gift view →',
      desktopPreviewAria: 'Reminder preview',
      livePreview: 'Live preview',
      privacyTip: 'The message travels inside the link. We do not store any data.',
      footerOrigin: 'Made in Peru · Finished in Galway',
      copied: '✓ Link copied. You can now save it to the NFC tag.',
      ready: 'Link ready. Press and hold to copy it.',
      copyReminderButton: 'Copy link for the NFC tag',
      copyStoryButton: 'Copy the How it was made link',
      reminderMicrocopy: 'Save this link to the pendant with NFC Tools.',
      storyMicrocopy: 'The same link works for every story tag.',
      openReminder: 'Open the gift view →',
      openStory: 'Open How it was made →',
      storyCopied: '✓ Story link copied. You can use it for every story tag.',
    },
  };

  let currentLanguage: CreatorLanguage = 'es';

  const selectedType = () => typeInputs.find((input) => input.checked)?.value === 'story' ? 'story' : 'reminder';

  const syncType = () => {
    const isStory = selectedType() === 'story';
    reminderFields.forEach((element) => element.hidden = isStory);
    storyFields.forEach((element) => element.hidden = !isStory);
    reminderPreviews.forEach((element) => element.hidden = isStory);
    storyPreviews.forEach((element) => element.hidden = !isStory);
    if (copyButton) copyButton.disabled = !isStory && !(message?.value.trim());
    if (copyLabel) copyLabel.textContent = translations[currentLanguage][isStory ? 'copyStoryButton' : 'copyReminderButton'];
    if (modeHelp) modeHelp.textContent = translations[currentLanguage][isStory ? 'storyMicrocopy' : 'reminderMicrocopy'];
    if (openLabel) openLabel.textContent = translations[currentLanguage][isStory ? 'openStory' : 'openReminder'];
    if (linkResult) linkResult.hidden = true;
  };

  const applyLanguage = (language: CreatorLanguage) => {
    currentLanguage = language;
    document.documentElement.lang = language;
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
      const key = element.dataset.i18n;
      if (key && translations[language][key]) element.textContent = translations[language][key];
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((element) => {
      const key = element.dataset.i18nAria;
      if (key && translations[language][key]) element.setAttribute('aria-label', translations[language][key]);
    });
    languageButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.language === language));
    });
    syncType();
    try {
      localStorage.setItem('happy-llama-language', language);
    } catch {}
  };

  languageButtons.forEach((button) => {
    button.addEventListener('click', () => applyLanguage(button.dataset.language === 'en' ? 'en' : 'es'));
  });

  const sampleMessage = 'I was in Galway and thought of you 🦙';
  const sampleFrom = 'With love, Happy Llama';

  const selectedScene = () => Number(new FormData(form!).get('scene') ?? 0);

  const updatePreview = () => {
    const text = message?.value.trim() || sampleMessage;
    const signature = from?.value.trim() || sampleFrom;
    previewMessages.forEach((preview) => preview.textContent = text);
    previewSignatures.forEach((preview) => preview.textContent = signature);
    if (count) count.textContent = String(message?.value.length ?? 0);
    if (copyButton) copyButton.disabled = selectedType() !== 'story' && !(message?.value.trim());
    if (message?.value.trim() && error) error.hidden = true;

    livePreviews.forEach((preview) => {
      const previewClass = preview.classList.contains('mobile-preview-card') ? 'mobile-preview-card' : 'keepsake-card';
      preview.className = `${previewClass} scene-${selectedScene()}`;
    });
  };

  const makeId = () => {
    const values = new Uint32Array(1);
    crypto.getRandomValues(values);
    return values[0].toString(36).slice(0, 5).padEnd(5, 'x');
  };

  const copyText = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }
    const helper = document.createElement('textarea');
    helper.value = text;
    helper.setAttribute('readonly', '');
    helper.style.position = 'fixed';
    helper.style.opacity = '0';
    document.body.append(helper);
    helper.select();
    const copied = document.execCommand('copy');
    helper.remove();
    return copied;
  };

  form?.addEventListener('input', updatePreview);
  form?.addEventListener('change', updatePreview);
  typeInputs.forEach((input) => input.addEventListener('change', syncType));

  const isTextField = (target: EventTarget | null) =>
    target instanceof HTMLTextAreaElement ||
    (target instanceof HTMLInputElement && target.type === 'text');

  form?.addEventListener('focusin', (event) => {
    if (isTextField(event.target)) form.classList.add('is-typing');
  });

  form?.addEventListener('focusout', () => {
    window.setTimeout(() => {
      if (!isTextField(document.activeElement)) form?.classList.remove('is-typing');
    }, 0);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const isStory = selectedType() === 'story';
    const text = message?.value.trim() ?? '';
    if (!isStory && !text) {
      if (error) error.hidden = false;
      message?.focus();
      return;
    }

    const url = isStory ? new URL('/', window.location.origin) : new URL(window.location.href);
    url.search = '';
    url.hash = '';
    if (isStory) {
      url.searchParams.set('v', 'story');
    } else {
      url.searchParams.set('id', makeId());
      url.searchParams.set('t', text);
      url.searchParams.set('b', String(selectedScene()));
      const signature = from?.value.trim();
      if (signature) url.searchParams.set('f', signature);
    }

    if (linkResult && generatedLink && copyStatus && openPreview) {
      generatedLink.href = url.toString();
      generatedLink.textContent = url.toString();
      openPreview.dataset.url = url.toString();
      linkResult.hidden = false;
      try {
        const copied = await copyText(url.toString());
        copyStatus.textContent = copied
          ? translations[currentLanguage][isStory ? 'storyCopied' : 'copied']
          : translations[currentLanguage].ready;
      } catch {
        copyStatus.textContent = translations[currentLanguage].ready;
      }
      linkResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  openPreview?.addEventListener('click', () => {
    const url = openPreview.dataset.url;
    if (url) window.open(url, '_blank', 'noopener,noreferrer');
  });

  let savedLanguage: CreatorLanguage = 'es';
  try {
    savedLanguage = localStorage.getItem('happy-llama-language') === 'en' ? 'en' : 'es';
  } catch {}
  applyLanguage(savedLanguage);
  updatePreview();
  syncType();
</script>
