<section class="hero-stage" id="hero-stage" aria-labelledby="hero-title">
  <h1 class="sr-only" id="hero-title">Your Happy Llama reminder</h1>

  <button class="hero-llama-trigger" id="hero-llama-trigger" type="button" aria-label="Make the Happy Llama walk">
    <span class="hero-llama-shadow" aria-hidden="true"></span>
    <img
      class="hero-llama"
      src="/assets/llama/cream-cutout-tight.webp"
      alt=""
      width="479"
      height="907"
      aria-hidden="true"
    />
    <span class="sr-only">Play the Happy Llama walking animation</span>
  </button>

  <section class="hero-gift-copy" aria-labelledby="gift-message">
    <p>A little reminder from Galway</p>
    <blockquote>
      <span class="sr-only" id="gift-message">A little Galway hello, especially for you.</span>
      <span id="gift-message-typed" aria-hidden="true">A little Galway hello, especially for you.</span>
      <span class="type-caret" aria-hidden="true"></span>
    </blockquote>
    <span id="gift-from">With love, Happy Llama</span>
  </section>

  <span class="hero-tap-cue" aria-hidden="true">Tap the llama</span>

  <div class="spark-field" aria-hidden="true">
    <i>✦</i><i>♥</i><i>✦</i><i>★</i><i>♥</i><i>✦</i>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('#hero-stage');
  const trigger = document.querySelector<HTMLButtonElement>('#hero-llama-trigger');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let celebrationTimer = 0;
  let walkingTimer = 0;

  const resetWalk = () => {
    stage?.classList.remove('is-walking');
    trigger?.setAttribute('aria-label', 'Make the Happy Llama walk');
  };

  const celebrate = () => {
    if (!stage || reducedMotion.matches) return;
    window.clearTimeout(celebrationTimer);
    stage.classList.remove('is-celebrating');
    requestAnimationFrame(() => stage.classList.add('is-celebrating'));
    celebrationTimer = window.setTimeout(() => stage.classList.remove('is-celebrating'), 900);
  };

  trigger?.addEventListener('click', () => {
    celebrate();
    window.dispatchEvent(new CustomEvent('happy-llama:retype'));
    if (!stage || reducedMotion.matches) return;
    window.clearTimeout(walkingTimer);
    stage.classList.remove('is-walking');
    requestAnimationFrame(() => stage.classList.add('is-walking'));
    trigger.setAttribute('aria-label', 'Replay the Happy Llama walk');
    walkingTimer = window.setTimeout(resetWalk, 2600);
  });
</script>
