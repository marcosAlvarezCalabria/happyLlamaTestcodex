<section class="hero-stage scene-0" id="hero-stage" aria-labelledby="hero-title">
  <h1 class="sr-only" id="hero-title">Your Happy Llama reminder</h1>

  <button class="hero-video-trigger" id="hero-video-trigger" type="button" aria-label="Make the Happy Llama walk">
    <video
      class="hero-video"
      id="hero-video"
      muted
      playsinline
      preload="metadata"
      poster="/assets/hero/happy-llama-tap-walk-poster.webp"
      aria-hidden="true"
    >
      <source
        src="/assets/hero/happy-llama-tap-walk.mp4"
        type="video/mp4"
      />
      <img
        src="/assets/hero/happy-llama-tap-walk-poster.webp"
        alt="A Happy Llama ready to walk"
        width="834"
        height="1112"
      />
    </video>
    <span class="sr-only">Play the Happy Llama walking animation</span>
  </button>

  <section class="hero-gift-copy" aria-labelledby="gift-message">
    <p>A little reminder from Galway</p>
    <blockquote>
      <span class="sr-only" id="gift-message">A little Galway hello, especially for you.</span>
      <span id="gift-message-typed" aria-hidden="true">A little Galway hello, especially for you.</span>
      <span class="type-caret" aria-hidden="true"></span>
    </blockquote>
    <span id="gift-from">With love, Happy Llama</span>
  </section>

  <span class="hero-tap-cue" aria-hidden="true">Tap the llama</span>

  <div class="spark-field" aria-hidden="true">
    <i>✦</i><i>♥</i><i>✦</i><i>★</i><i>♥</i><i>✦</i>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('#hero-stage');
  const trigger = document.querySelector<HTMLButtonElement>('#hero-video-trigger');
  const video = document.querySelector<HTMLVideoElement>('#hero-video');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let celebrationTimer = 0;

  const resetWalk = () => {
    stage?.classList.remove('is-walking');
    trigger?.setAttribute('aria-label', 'Make the Happy Llama walk');
  };

  const celebrate = () => {
    if (!stage || reducedMotion.matches) return;
    window.clearTimeout(celebrationTimer);
    stage.classList.remove('is-celebrating', 'video-needs-play');
    requestAnimationFrame(() => stage.classList.add('is-celebrating'));
    celebrationTimer = window.setTimeout(() => stage.classList.remove('is-celebrating'), 900);
  };

  trigger?.addEventListener('click', () => {
    celebrate();
    window.dispatchEvent(new CustomEvent('happy-llama:retype'));
    if (!video) return;
    video.currentTime = 0;
    stage?.classList.add('is-walking');
    trigger.setAttribute('aria-label', 'Replay the Happy Llama walk');
    void video.play().catch(() => {
      resetWalk();
      stage?.classList.add('video-needs-play');
    });
  });

  video?.addEventListener('ended', () => {
    video.currentTime = 0;
    resetWalk();
  });

  video?.addEventListener('error', resetWalk);

  video?.pause();
</script>
